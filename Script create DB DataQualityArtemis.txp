iewAttributeMS17 ObjectType="2037" CSAOName="PERViewAttributeMS17" CSAOCaption="View Attribute"><Id>{91FAF20B-F3CD-4B4E-8FC8-977C63DF19F8}</Id><Name>DescrizioneTipoValidazioneCodiceFiscale</Name><Ordinal>0</Ordinal><GlobalOrder>0</GlobalOrder><Alias></Alias><Expression></Expression><ExternalAttrSourceDT></ExternalAttrSourceDT><ExternalTittle></ExternalTittle><ExternalSrcAttributeOwnerCaption></ExternalSrcAttributeOwnerCaption><ExternalSrcAttributeName></ExternalSrcAttributeName><ExternalSrcAttributeOwnerName></ExternalSrcAttributeOwnerName><ExternalUniqueInSources>0</ExternalUniqueInSources><Attribute><Id>{C741F7A1-D315-429F-9D5C-40BF1014CE53}</Id></Attribute><Relation><Id>{224B4526-1557-4276-8D08-B2B4B6C21830}</Id></Relation><ViewAttributeOrder/><ViewAttributeGroup/></PERViewAttributeMS17></ViewAttributes><Aliases></Aliases><ChangeTracking>AUTO</ChangeTracking><ColumnList></ColumnList><Encryption>0</Encryption><FulltextCatalog/><IndexName></IndexName><IndexSQL></IndexSQL><Percent>0</Percent><Schemabinding>0</Schemabinding><Top>0</Top><TopExpression></TopExpression><ViewComment></ViewComment><ViewMetadata>0</ViewMetadata><WithCheckOption>0</WithCheckOption><WithTies>0</WithTies><FIStoplistOFF>0</FIStoplistOFF><FulltextIndexFilegroup/><SearchPropertyList/><Stoplist/></PERViewMS17><PERViewMS17 ObjectType="2005" CSAOName="PERViewMS17" CSAOCaption="View"><Id>{2EAA43CC-7BC2-487A-B00F-7E1B33548C0D}</Id><Name>DEP_V_DatiPensioni</Name><Ordinal>0</Ordinal><GlobalOrder>0</GlobalOrder><GalleryItemID>{00000000-0000-0000-0000-000000000000}</GalleryItemID><GalleryID>{00000000-0000-0000-0000-000000000000}</GalleryID><GalleryObjectID>{00000000-0000-0000-0000-000000000000}</GalleryObjectID><RNOffset>0</RNOffset><RNLength>0</RNLength><IgnoreNC>0</IgnoreNC><VerifyState>1</VerifyState><GenerateCode>1</GenerateCode><BeforeScript></BeforeScript><AfterScript></AfterScript><Notes></Notes><Comments></Comments><SQL><![CDATA[AS 
SELECT p.DatiPensioniID,
       p.AnagraficaArcaID,
       p.Archivio,
       p.CatPenCodice,
       p.CatePen,
       p.CertPen,
       p.CodeLipe,
       p.SedePen,
       p.TipoComp,
       p.ChiaveIndividuale,
       p.CodiceEventoDiario,
       e.CODICEEVENTO
FROM [DEP_DatiPensioni] AS p
     INNER JOIN dbo.[DEP_AnagraficaArca] AS a ON a.ID = p.AnagraficaArcaID
     INNER JOIN dbo.[DEP_EventiArca_Flussi] e ON e.ID = a.ID]]></SQL><Caption>DEP_V_DatiPensioni</Caption><GenerateSQLOnly>0</GenerateSQLOnly><OrderByText></OrderByText><GroupText></GroupText><WhereText></WhereText><HavingText></HavingText><SelectInViewsAsText>1</SelectInViewsAsText><Distinct>0</Distinct><ExternalSourceRelations></ExternalSourceRelations><DevNotes></DevNotes><Schema><Id>{9D7FDC2A-2DCE-4A1A-AF2F-C0521A3EA0B5}</Id></Schema><DbOwner/><Category/><Aliases></Aliases><ChangeTracking>AUTO</ChangeTracking><ColumnList></ColumnList><Encryption>0</Encryption><FulltextCatalog/><IndexName></IndexName><IndexSQL></IndexSQL><Percent>0</Percent><Schemabinding>0</Schemabinding><Top>0</Top><TopExpression></TopExpression><ViewComment></ViewComment><ViewMetadata>0</ViewMetadata><WithCheckOption>0</WithCheckOption><WithTies>0</WithTies><FIStoplistOFF>0</FIStoplistOFF><FulltextIndexFilegroup/><SearchPropertyList/><Stoplist/></PERViewMS17><PERViewMS17 ObjectType="2005" CSAOName="PERViewMS17" CSAOCaption="View"><Id>{FDF6C452-7432-4F07-A43B-A0576633898A}</Id><Name>DEP_V_DatiElaboratiForTbTran19</Name><Ordinal>0</Ordinal><GlobalOrder>0</GlobalOrder><GalleryItemID>{00000000-0000-0000-0000-000000000000}</GalleryItemID><GalleryID>{00000000-0000-0000-0000-000000000000}</GalleryID><GalleryObjectID>{00000000-0000-0000-0000-000000000000}</GalleryObjectID><RNOffset>0</RNOffset><RNLength>0</RNLength><IgnoreNC>0</IgnoreNC><VerifyState>1</VerifyState><GenerateCode>1</GenerateCode><BeforeScript></BeforeScript><AfterScript></AfterScript><Notes></Notes><Comments></Comments><SQL><![CDATA[AS
              SELECT c.DatiPensioniID,
                   c.CatPenCodice,
                   c.CatePen,
                   c.SedePen,
                   c.CertPen,
                   a.CodiceFiscale,
                   t.CFCCC1_EV0,
                   t.PROGR_EV0,
                   t.ID AS EventiArcaFlussiID
            FROM DS05259_PNRR36_DataQuality.dbo.[DEP_EventiArca_Flussi] AS t
                 INNER JOIN dbo.[DEP_AnagraficaArca] AS a ON a.ID = t.ID
                 INNER JOIN dbo.[DEP_FlussiElaborati] AS b ON b.AnagraficaArcaID = a.ID
                 INNER JOIN dbo.[DEP_DatiPensioni] AS c ON c.AnagraficaArcaID = a.ID
            WHERE     1 = 1
                  AND b.Inviato = 1
                  AND t.TipologiaEventiID = 3]]></SQL><Caption>DEP_V_DatiElaboratiForTbTran19</Caption><GenerateSQLOnly>0</GenerateSQLOnly><OrderByText></OrderByText><GroupText></GroupText><WhereText></WhereText><HavingText></HavingText><SelectInViewsAsText>1</SelectInViewsAsText><Distinct>0</Distinct><ExternalSourceRelations></ExternalSourceRelations><DevNotes></DevNotes><Schema><Id>{9D7FDC2A-2DCE-4A1A-AF2F-C0521A3EA0B5}</Id></Schema><DbOwner/><Category/><Aliases></Aliases><ChangeTracking>AUTO</ChangeTracking><ColumnList></ColumnList><Encryption>0</Encryption><FulltextCatalog/><IndexName></IndexName><IndexSQL></IndexSQL><Percent>0</Percent><Schemabinding>0</Schemabinding><Top>0</Top><TopExpression></TopExpression><ViewComment></ViewComment><ViewMetadata>0</ViewMetadata><WithCheckOption>0</WithCheckOption><WithTies>0</WithTies><FIStoplistOFF>0</FIStoplistOFF><FulltextIndexFilegroup/><SearchPropertyList/><Stoplist/></PERViewMS17></Views><Schemas><PERSchemaMS17 ObjectType="2024" CSAOName="PERSchemaMS17" CSAOCaption="Schema"><Id>{57A02728-F14A-47D3-9648-8F352A070F5F}</Id><Name>DefaultSchema</Name><Ordinal>0</Ordinal><GlobalOrder>0</GlobalOrder><GalleryItemID>{00000000-0000-0000-0000-000000000000}</GalleryItemID><GalleryID>{00000000-0000-0000-0000-000000000000}</GalleryID><GalleryObjectID>{00000000-0000-0000-0000-000000000000}</GalleryObjectID><RNOffset>0</RNOffset><RNLength>0</RNLength><IgnoreNC>0</IgnoreNC><VerifyState>1</VerifyState><GenerateCode>0</GenerateCode><Notes></Notes><Caption>DefaultSchema</Caption><Authorization></Authorization></PERSchemaMS17><PERSchemaMS17 ObjectType="2024" CSAOName="PERSchemaMS17" CSAOCaption="Schema"><Id>{9D7FDC2A-2DCE-4A1A-AF2F-C0521A3EA0B5}</Id><Name>dbo</Name><Ordinal>0</Ordinal><GlobalOrder>0</GlobalOrder><GalleryItemID>{00000000-0000-0000-0000-000000000000}</GalleryItemID><GalleryID>{00000000-0000-0000-0000-000000000000}</GalleryID><GalleryObjectID>{00000000-0000-0000-0000-000000000000}</GalleryObjectID><RNOffset>0</RNOffset><RNLe