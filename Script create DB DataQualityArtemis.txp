</Value><Null>0</Null></PERExtendedPropertyMS17><PERExtendedPropertyMS17 ObjectType="2042" CSAOName="PERExtendedPropertyMS17" CSAOCaption="Extended Property MS17"><Id>{0F8C9AF9-9C9E-4EA2-9496-CBDD5D91BE85}</Id><Name>MS_DiagramPaneCount</Name><Ordinal>0</Ordinal><GlobalOrder>0</GlobalOrder><GalleryItemID>{00000000-0000-0000-0000-000000000000}</GalleryItemID><GalleryID>{00000000-0000-0000-0000-000000000000}</GalleryID><GalleryObjectID>{00000000-0000-0000-0000-000000000000}</GalleryObjectID><VerifyState>1</VerifyState><GenerateCode>1</GenerateCode><BeforeScript></BeforeScript><AfterScript></AfterScript><Notes></Notes><Comments></Comments><Value>1</Value><Null>0</Null></PERExtendedPropertyMS17></ExtendedProperties><FulltextCatalog/><IndexName></IndexName><IndexSQL></IndexSQL><Percent>0</Percent><Schemabinding>0</Schemabinding><Top>0</Top><TopExpression></TopExpression><ViewComment></ViewComment><ViewMetadata>0</ViewMetadata><WithCheckOption>0</WithCheckOption><WithTies>0</WithTies><FIStoplistOFF>0</FIStoplistOFF><FulltextIndexFilegroup/><SearchPropertyList/><Stoplist/></PERViewMS17><PERViewMS17 ObjectType="2005" CSAOName="PERViewMS17" CSAOCaption="View"><Id>{507AB7B6-0853-4FD8-9F79-D8D021EBAE70}</Id><Name>DEP_V_FlussiElaborati</Name><Ordinal>0</Ordinal><GlobalOrder>0</GlobalOrder><GalleryItemID>{00000000-0000-0000-0000-000000000000}</GalleryItemID><GalleryID>{00000000-0000-0000-0000-000000000000}</GalleryID><GalleryObjectID>{00000000-0000-0000-0000-000000000000}</GalleryObjectID><RNOffset>0</RNOffset><RNLength>0</RNLength><IgnoreNC>0</IgnoreNC><VerifyState>1</VerifyState><GenerateCode>1</GenerateCode><BeforeScript></BeforeScript><AfterScript></AfterScript><Notes></Notes><Comments></Comments><SQL><![CDATA[CREATE VIEW [dbo].[DEP_V_FlussiElaborati]
AS

SELECT DISTINCT
       FE.[AnagraficaArcaID],
       EAF.[CFCCC1_EV0] AS [CFCCC1],
       EAF.[PROGR_EV0] AS [PROGR],
       AA.[Nome],
       AA.[Cognome],
       AA.[CodiceFiscale] AS [CodiceFiscaleNew],
       FE.[CodiceFiscaleOld] AS [CodiceFiscaleOld],
       AA.[CodiceCittadinanza] AS [CodiceCittadinanzaNew],
       FE.[CodiceCittadinanzaOld] AS [CodiceCittadinanzaOld],
       AA.[Cittadinanza] AS [CittadinanzaNew],
       FE.[CittadinanzaOld] AS [CittadinanzaOld],
       AA.[CodiceTipoIndirizzo] AS [CodiceTipoIndirizzoNew],
       AA.[DescrizioneTipoIndirizzo] AS [DescrizioneTipoIndirizzoNew],
       AA.[Nazionalita] AS [NazionalitaNew],
       FE.[NazionalitaOld] AS [NazionalitaOld],
       TE.[TipologiaEventiID],
       TE.[DescrizioneEvento],
       FE.[TipoEvento],
       FE.[Inviato],
       EAF.[LogFlussiID],
       EAF.[TIMEST1_EV0],
       AA.[DataVariazioneIndirizzo] AS [DataDecorrenzaIrr],
       PVA.[TipoValidazioneCodiceFiscale],
       PVA.[DescrizioneTipoValidazioneCodiceFiscale]
FROM [dbo].[DEP_FlussiElaborati] AS FE
INNER JOIN [dbo].[DEP_TipologiaEventi] AS TE
    ON TE.[TipologiaEventiID] = FE.[TipologiaEventiID]
INNER JOIN [dbo].[DEP_AnagraficaArca] AS AA
    ON AA.[ID] = FE.[AnagraficaArcaID]
INNER JOIN [dbo].[DEP_EventiArca_Flussi] AS EAF
    ON EAF.[ID] = AA.[ID]
LEFT JOIN [dbo].[DEP_PreVariazioneAnagraficaArca] AS PVA
    ON PVA.[ID] = AA.[ID]
WHERE FE.[Inviato] = 0 AND EAF.[FlagScarto] = 0;]]></SQL><Caption>DEP_V_FlussiElaborati</Caption><GenerateSQLOnly>1</GenerateSQLOnly><OrderByText></OrderByText><GroupText></GroupText><WhereText>[DEP_TipologiaEventi].TipologiaEventiID =
                [DEP_FlussiElaborati].TipologiaEventiID
            AND [DEP_FlussiElaborati].AnagraficaArcaID =
                [DEP_AnagraficaArca].ID
            AND [DEP_EventiArca_Flussi].ID = [DEP_AnagraficaArca].ID    
            AND [DEP_PreVariazioneAnagraficaArca].ID = [DEP_AnagraficaArca].ID       
            AND [DEP_FlussiElaborati].Inviato = 0</WhereText><HavingText></HavingText><SelectInViewsAsText>1</SelectInViewsAsText><Distinct>1</Distinct><ExternalSourceRelations></ExternalSourceRelations><DevNotes></DevNotes><Schema><Id>{9D7FDC2A-2DCE-4A1A-AF2F-C0521A3EA0B5}</Id></Schema><DbOwner/><Category/><ViewRelations><Id>{3C259E95-FB63-423A-A30C-219AA0A128A5}</Id><Id>{97D954AD-1B3E-4021-9D58-890321021593}</Id><Id>{0DC89BA0-8A48-4192-B0B6-16E1C827FD75}</Id><Id>{D2D88B2F-35A9-4EE9-898C-46BBC79796B1}</Id><Id>{224B4526-1557-4276-8D08-B2B4B6C21830}</Id></ViewRelations><ViewAttributes><PERViewAttributeMS17 ObjectType="2037" CSAOName="PERViewAttributeMS17" CSAOCaption="View Attribute"><Id>{4095F5B2-00BE-4AC2-B4F9-D1087FD7ED67}</Id><Name>CFCCC1</Name><Ordinal>0</Ordinal><GlobalOrder>0</GlobalOrder><Alias>CFCCC1</Alias><Expression></Expression><ExternalAttrSourceDT></ExternalAttrSourceDT><ExternalTittle></ExternalTittle><ExternalSrcAttributeOwnerCaption></ExternalSrcAttributeOwnerCaption><ExternalSrcAttributeName></ExternalSrcAttributeName><ExternalSrcAttributeOwnerName></ExternalSrcAttributeOwnerName><ExternalUniqueInSources>0</ExternalUniqueInSources><Attribute><Id>{8FB95A36-4A6C-4114-81ED-5150C97E26DF}</Id></Attribute><Relation><Id>{D2D88B2F-35A9-4EE9-898C-46BBC79796B1}</Id></Relation><ViewAttributeOrder/><ViewAttributeGroup/></PERViewAttributeMS17><PERViewAttributeMS17 ObjectType="2037" CSAOName="PERViewAttributeMS17" CSAOCaption="View Attribute"><Id>{2B8BED0E-3300-4913-A3F9-AE2949B3BDB7}</Id><Name>PROGR</Name><Ordinal>0</Ordinal><GlobalOrder>0</GlobalOrder><Alias>PROGR</Alias><Expression></Expression><ExternalAttrSourceDT></ExternalAttrSourceDT><ExternalTittle></ExternalTittle><ExternalSrcAttributeOwnerCaption></ExternalSrcAttributeOwnerCaption><ExternalSrcAttributeName></ExternalSrcAttributeName><ExternalSrcAttributeOwnerName></ExternalSrcAttributeOwnerName><ExternalUniqueInSources>0</ExternalUniqueInSources><Attribute><Id>{8167BE99-46DF-47FE-8DB8-F726E366CAF2}</I