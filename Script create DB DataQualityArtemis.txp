hild><InverseName></InverseName><Caption>R_DT_RDD</Caption><InverseCaption></InverseCaption><RefIntegrityParentUpdate>1</RefIntegrityParentUpdate><RefIntegrityParentDelete>3</RefIntegrityParentDelete><Key><Id>{CAD24B60-A999-4760-B792-2DB9E605D649}</Id></Key><ForeignKeys><PERForeignKeyMS17 ObjectType="2014" CSAOName="PERForeignKeyMS17" CSAOCaption="Foreign Key"><Id>{7C19D4AE-D90E-41DF-9223-F6481CB097BD}</Id><Name>FK DiarioID - DiarioID</Name><Ordinal>0</Ordinal><GlobalOrder>0</GlobalOrder><GalleryItemID>{00000000-0000-0000-0000-000000000000}</GalleryItemID><GalleryID>{00000000-0000-0000-0000-000000000000}</GalleryID><GalleryObjectID>{00000000-0000-0000-0000-000000000000}</GalleryObjectID><VerifyState>1</VerifyState><AttrParent><Id>{E237FA24-5F1D-4610-B21B-5C54EE801F36}</Id></AttrParent><AttrChild><Id>{06BE2E8B-B5E0-4016-B328-45A7844C3E14}</Id></AttrChild><KeyConstraintItem><Id>{5D515FA4-22A2-463A-99AC-65CC7CFC2115}</Id></KeyConstraintItem><IndexItem/></PERForeignKeyMS17></ForeignKeys><Category/><ForeignIndex/><DisabledConstraint>0</DisabledConstraint><IsNotTrusted>0</IsNotTrusted><NotForReplication>0</NotForReplication></PERRelationMS17><PERRelationMS17 ObjectType="2004" CSAOName="PERRelationMS17" CSAOCaption="Relation"><Id>{93F8C662-D708-4CDE-A902-CB7EFEE82CB5}</Id><Name>R_RDD_EFD</Name><Ordinal>0</Ordinal><GlobalOrder>0</GlobalOrder><O1><Id>{7E979B08-D999-4A3F-B55A-CF4C8CC20FD9}</Id></O1><O2><Id>{77565198-B06B-4312-A4BE-ED990CC12960}</Id></O2><GenerateCode>1</GenerateCode><Comments></Comments><Notes></Notes><DevNotes></DevNotes><Identifying>0</Identifying><MandatoryParent>1</MandatoryParent><MandatoryChild>0</MandatoryChild><CardinalityChild>-1</CardinalityChild><InverseName></InverseName><Caption>R_RDD_EFD</Caption><InverseCaption></InverseCaption><RefIntegrityParentUpdate>1</RefIntegrityParentUpdate><RefIntegrityParentDelete>3</RefIntegrityParentDelete><Key><Id>{27BB2D03-42B1-499C-9A31-377432FAF1C4}</Id></Key><ForeignKeys><PERForeignKeyMS17 ObjectType="2014" CSAOName="PERForeignKeyMS17" CSAOCaption="Foreign Key"><Id>{710D8288-4700-4EBF-A38A-EF4DAA63D392}</Id><Name>FK DiarioID - DiarioID</Name><Ordinal>0</Ordinal><GlobalOrder>0</GlobalOrder><GalleryItemID>{00000000-0000-0000-0000-000000000000}</GalleryItemID><GalleryID>{00000000-0000-0000-0000-000000000000}</GalleryID><GalleryObjectID>{00000000-0000-0000-0000-000000000000}</GalleryObjectID><VerifyState>1</VerifyState><AttrParent><Id>{06BE2E8B-B5E0-4016-B328-45A7844C3E14}</Id></AttrParent><AttrChild><Id>{E75D9C08-8C33-4014-A2EA-FBB471CBE87D}</Id></AttrChild><KeyConstraintItem><Id>{28C16152-B570-43F7-A4ED-110635B813D2}</Id></KeyConstraintItem><IndexItem><Id>{DA3605F0-31AD-4303-8CDB-3D99A2486756}</Id></IndexItem></PERForeignKeyMS17></ForeignKeys><Category/><ForeignIndex><Id>{F350FF05-6114-4FCD-8168-7853650ED5EA}</Id></ForeignIndex><DisabledConstraint>0</DisabledConstraint><IsNotTrusted>0</IsNotTrusted><NotForReplication>0</NotForReplication></PERRelationMS17></Relations><Procedures><PERProcedureMS17 ObjectType="2015" CSAOName="PERProcedureMS17" CSAOCaption="Procedure"><Id>{B03F1245-FF72-4325-B9E4-191628AD947B}</Id><Name>DEP_RICERCA_DATI_ELABORATI</Name><Ordinal>0</Ordinal><GlobalOrder>0</GlobalOrder><GalleryItemID>{00000000-0000-0000-0000-000000000000}</GalleryItemID><GalleryID>{00000000-0000-0000-0000-000000000000}</GalleryID><GalleryObjectID>{00000000-0000-0000-0000-000000000000}</GalleryObjectID><RNOffset>0</RNOffset><RNLength>0</RNLength><IgnoreNC>0</IgnoreNC><VerifyState>1</VerifyState><GenerateCode>1</GenerateCode><BeforeScript></BeforeScript><AfterScript></AfterScript><Notes></Notes><Comments></Comments><SQL><![CDATA[AS
SET  NOCOUNT ON;

SELECT c.DatiPensioniID,
       c.CatPenCodice,
       c.CatePen,
       c.SedePen,
       c.CertPen,
       a.CodiceFiscale,
       t.CFCCC1_EV0,
       t.PROGR_EV0,
       t.ID AS EventiArcaFlussiID
FROM DS05259_PNRR36_DataQuality.dbo.[DEP_EventiArca_Flussi] AS t
     INNER JOIN dbo.[DEP_AnagraficaArca] AS a ON a.ID = t.ID
     INNER JOIN dbo.[DEP_FlussiElaborati] AS b ON b.AnagraficaArcaID = a.ID
     INNER JOIN dbo.[DEP_DatiPensioni] AS c ON c.AnagraficaArcaID = a.ID
WHERE     1 = 1
      AND b.Inviato = 1
      AND t.TipologiaEventiID = 3
      AND c.CatePen = @CodiceCategoria
      AND c.SedePen = @CodiceSede
      AND c.CertPen = @Certificato
      AND a.CodiceFiscale = @CodiceFiscale
      AND t.CFCCC1_EV0 = @CodArca
      AND t.PROGR_EV0 = @ProgArca]]></SQL><Caption>DEP_RICERCA_DATI_ELABORATI</Caption><GenerateSQLOnly>0</GenerateSQLOnly><Schema><Id>{9D7FDC2A-2DCE-4A1A-AF2F-C0521A3EA0B5}</Id></Schema><DbOwner/><AClassName></AClassName><AMethodName></AMethodName><ArgumentList>@CodiceCategoria   CHAR (50), @CodiceSede        CHAR (4), @Certificato       CHAR (8), @CodiceFiscale     CHAR (16), @CodArca           CHAR (3), @ProgArca          INT</ArgumentList><Assembly/><DLLName></DLLName><ExecuteAs>CALLER</ExecuteAs><ExecuteAsUser></ExecuteAsUser><ForReplication>0</ForReplication><ProcedureComment></ProcedureComment><ProcedureType>SP</ProcedureType><WithEncryption>0</WithEncryption><WithRecompile>0</WithRecompile></PERProcedureMS17><PERProcedureMS17 ObjectType="2015" CSAOName="PERProcedureMS17" CSAOCaption="Procedure"><Id>{BC19FC8C-4ACF-480E-9A29-FCA79D55EF13}</Id><Name>DEP_SP_GETEVENTIDALAVORARE</Name><Ordinal>0</Ordinal><GlobalOrder>0</GlobalOrder><GalleryItemID>{00000000-0000-0000-0000-000000000000}</GalleryItemID><GalleryID>{00000000-0000-0000-0000-000000000000}</GalleryID><GalleryObjectID>{00000000-0000-0000-0000-000000000000}</GalleryObjectID><RNOffset>0</RNOffset><RNLength>0</RNLength><IgnoreNC>0</IgnoreNC><VerifyState>1</VerifyState><GenerateCode>1</GenerateCode><BeforeScript></BeforeScript><AfterScript></AfterScript><Notes></Notes><Comments></Comments><SQL><![CDATA[AS
BEGIN
    SET NOCOUNT ON;
    SET XACT_ABORT ON;

    DECLARE @StatoInLavorazione INT;
    DECLARE @NumeroEventiInAttesa INT = 0;
    DECLARE @DataEventoPiuVecchio DATETIME2;
    DECLARE @ElaboraNuoviEventi BIT = 0;
    DECLARE @DataCorrente DATETIME2 = SYSUTCDATETIME();

    DECLARE @EventiPresi TABLE
    (
        ID BIGINT PRIMARY KEY
    );

    /*
        Recupera lo stato IN_LAVORAZIONE.
    */
    SELECT @StatoInLavorazione = StatoWorkerID
    FROM dbo.DEP_StatoWorkers
    WHERE DescStato = 'IN_LAVORAZIONE';

    IF @StatoInLavorazione IS NULL
    BEGIN
        THROW 50001,
              'Stato IN_LAVORAZIONE non configurato in DEP_StatoWorkers.',
              1;
    END;

    IF @NumeroRecord <= 0
    BEGIN
        THROW 50002,
              'Il parametro @NumeroRecord deve essere maggiore di zero.',
              1;
    END;

    IF @SogliaRecord <= 0
    BEGIN
        THROW 50003,
              'Il parametro @SogliaRecord deve essere maggiore di zero.',
              1;
    END;

    BEGIN TRY

        BEGIN TRANSACTION;

        /*
            Recupera al massimo il numero di record necessario
            per verificare il raggiungimento della soglia.

            Vengono considerati esclusivamente gli eventi
            mai presi in carico.
        */
        ;WITH PrimiEventiInAttesa AS
        (
            SELECT TOP (@SogliaRecord)
                   E.ID,
                   E.DataInserimento
            FROM dbo.DEP_EventiArca_Flussi E
            LEFT JOIN dbo.DEP_Workers W
                ON W.ID = E.ID
            WHERE
                E.TipologiaEventiID_Artemis IS NOT NULL
                AND E.EventiArtemisID IS NOT NULL
                AND E.TipologiaEventiID IS NULL
                AND E.LottoPrelievoID IS NULL
                AND E.DataElaborazione IS NULL
                AND E.FlagScarto = 0
                AND W.ID IS NULL
            ORDER BY
                E.DataInserimento,
                E.ID
        )
        SELECT
            @NumeroEventiInAttesa = COUNT(*),
            @DataEventoPiuVecchio = MIN(DataInserimento)
        FROM PrimiEventiInAttesa;

        /*
            La lavorazione dei nuovi eventi viene attivata se:

            1. è stata raggiunta la soglia, ad esempio 50 record;
            2. oppure l'evento più vecchio è presente da almeno
               5 minuti.
        */
        IF
        (
            @NumeroEventiInAttesa >= @SogliaRecord
            OR
            (
                @DataEventoPiuVecchio IS NOT NULL
                AND @DataEventoPiuVecchio <=
                    DATEADD(
                        MINUTE,
                        -@AttesaMassimaMinuti,
                        @DataCorrente
                    )
            )
        )
        BEGIN
            SET @ElaboraNuoviEventi = 1;
        END;

        /*
            Acquisizione atomica degli eventi.

            Vengono selezionati:

            - i nuovi eventi, solamente se è stata raggiunta la
              soglia oppure sono trascorsi 5 minuti;

            - gli eventi rimasti IN_LAVORAZIONE oltre il timeout
              di 30 minuti, indipendentemente dalla soglia.
        */
        ;WITH EventiDaPrendere AS
        (
            SELECT TOP (@NumeroRecord)
                   E.ID
            FROM dbo.DEP_EventiArca_Flussi E
            LEFT JOIN dbo.DEP_Workers W WITH
                (UPDLOCK, READPAST, ROWLOCK)
                ON W.ID = E.ID
            WHERE
                E.TipologiaEventiID_Artemis IS NOT NULL
                AND E.EventiArtemisID IS NOT NULL
                AND E.TipologiaEventiID IS NULL
                AND E.LottoPrelievoID IS NULL
                AND E.DataElaborazione IS NULL
                AND E.FlagScarto = 0
                AND
                (
                    /*
                        Evento mai preso in carico.
                    */
                    (
                        @ElaboraNuoviEventi = 1
                        AND W.ID IS NULL
                    )

                    OR

                    /*
                        Evento rimasto IN_LAVORAZIONE
                        oltre il timeout configurato.
                    */
                    (
                        W.StatoWorkerID = @StatoInLavorazione
                        AND W.DataPresaInCarico <
                            DATEADD(
                                MINUTE,
                                -@TimeoutLavorazioneMinuti,
                                @DataCorrente
                            )
                    )
                )
            ORDER BY
                CASE
                    WHEN W.ID IS NOT NULL THEN 0
                    ELSE 1
                END,
                E.DataInserimento,
                E.ID
        )
        MERGE dbo.DEP_Workers WITH (HOLDLOCK) AS Target
        USING EventiDaPrendere AS Source
            ON Target.ID = Source.ID

        /*
            Il record viene aggiornato solamente se è ancora
            effettivamente scaduto.

            Questa condizione impedisce a un secondo Pod di
            riprendere un record appena acquisito da un altro Pod.
        */
        WHEN MATCHED
             AND Target.StatoWorkerID = @StatoInLavorazione
             AND Target.DataPresaInCarico <
                 DATEADD(
                     MINUTE,
                     -@TimeoutLavorazioneMinuti,
                     @DataCorrente
                 )
        THEN
            UPDATE SET
                Target.StatoWorkerID = @StatoInLavorazione,
                Target.DataPresaInCarico = @DataCorrente

        /*
            Evento mai preso in carico.
        */
        WHEN NOT MATCHED THEN
            INSERT
            (
                ID,
                StatoWorkerID,
                DataPresaInCarico
            )
            VALUES
            (
                Source.ID,
                @StatoInLavorazione,
                @DataCorrente
            )

        OUTPUT inserted.ID
            INTO @EventiPresi(ID);

        COMMIT TRANSACTION;

        /*
            Restituisce solamente gli eventi effettivamente
            acquisiti dal Pod corrente.
        */
        SELECT E.*
        FROM dbo.DEP_EventiArca_Flussi E
        INNER JOIN @EventiPresi P
            ON P.ID = E.ID
        ORDER BY
            E.DataInserimento,
            E.ID;

    END TRY
    BEGIN CATCH

        IF @@TRANCOUNT > 0
            ROLLBACK TRANSACTION;

        THROW;

    END CATCH;
END]]></SQL><Caption>DEP_SP_GETEVENTIDALAVORARE</Caption><GenerateSQLOnly>0</GenerateSQLOnly><Schema><Id>{9D7FDC2A-2DCE-4A1A-AF2F-C0521A3EA0B5}</Id></Schema><DbOwner/><AClassName></AClassName><AMethodName></AMethodName><ArgumentList>@NumeroRecord INT = 100,
@SogliaRecord INT = 50,
@AttesaMassimaMinuti INT = 5,
@TimeoutLavorazioneMinuti INT = 30</ArgumentList><Assembly/><DLLName></DLLName><ExecuteAs>CALLER</ExecuteAs><ExecuteAsUser></ExecuteAsUser><ForReplication>0</ForReplication><ProcedureComment></ProcedureComment><ProcedureType>SP</ProcedureType><WithEncryption>0</WithEncryption><WithRecompile>1</WithRecompile></PERProcedureMS17></Procedures><Views><PERViewMS17 ObjectType="2005" CSAOName="PERViewMS17" CSAOCaption="View"><Id>{A5C0055E-DDA5-4D32-956F-D194FE73EC69}</Id><Name>DEP_V_RicercaDatiElaborati</Name><Ordinal>0</Ordinal><GlobalOrder>0</GlobalOrder><GalleryItemID>{00000000-0000-0000-0000-000000000000}</GalleryItemID><GalleryID>{00000000-0000-0000-0000-000000000000}</GalleryID><GalleryObjectID>{00000000-0000-0000-0000-000000000000}</GalleryObjectID><RNOffset>0</RNOffset><RNLength>0</RNLength><IgnoreNC>0</IgnoreNC><VerifyState>1</VerifyState><GenerateCode>1</GenerateCode><BeforeScript></BeforeScript><AfterScript></AfterScript><Notes></Notes><Comments></Comments><SQL><![CDATA[AS
SELECT   dbo.DEP_DatiPensioni.DatiPensioniID, dbo.DEP_DatiPensioni.CatPenCodice, dbo.DEP_DatiPensioni.CatePen, dbo.DEP_DatiPensioni.SedePen, dbo.DEP_DatiPensioni.CertPen, 
                         dbo.DEP_AnagraficaArca.CodiceFiscale, dbo.DEP_EventiArca_Flussi.CFCCC1_EV0, dbo.DEP_EventiArca_Flussi.PROGR_EV0, dbo.DEP_EventiArca_Flussi.ID AS EventiArcaFlussiID
FROM         dbo.DEP_DatiPensioni INNER JOIN
                         dbo.DEP_AnagraficaArca ON dbo.DEP_DatiPensioni.AnagraficaArcaID = dbo.DEP_AnagraficaArca.ID INNER JOIN
                         dbo.DEP_EventiArca_Flussi ON dbo.DEP_AnagraficaArca.ID = dbo.DEP_EventiArca_Flussi.ID]]></SQL><Caption>DEP_V_RicercaDatiElaborati</Caption><GenerateSQLOnly>0</GenerateSQLOnly><OrderByText></OrderByText><GroupText></GroupText><WhereText></WhereText><HavingText></HavingText><SelectInViewsAsText>1</SelectInViewsAsText><Distinct>0</Distinct><ExternalSourceRelations></ExternalSourceRelations><DevNotes></DevNotes><Schema><Id>{9D7FDC2A-2DCE-4A1A-AF2F-C0521A3EA0B5}</Id></Schema><DbOwner/><Category/><Aliases></Aliases><ChangeTracking>AUTO</ChangeTracking><ColumnList></ColumnList><Encryption>0</Encryption><ExtendedProperties><PERExtendedPropertyMS17 ObjectType="2042" CSAOName="PERExtendedPropertyMS17" CSAOCaption="Extended Property MS17"><Id>{C76CCBD1-5E89-4DAD-BE73-7140020451F6}</Id><Name>MS_DiagramPane1</Name><Ordinal>0</Ordinal><GlobalOrder>0</GlobalOrder><GalleryItemID>{00000000-0000-0000-0000-000000000000}</GalleryItemID><GalleryID>{00000000-0000-0000-0000-000000000000}</GalleryID><GalleryObjectID>{00000000-0000-0000-0000-000000000000}</GalleryObjectID><VerifyState>1</VerifyState><GenerateCode>1</GenerateCode><BeforeScript></BeforeScript><AfterScript></AfterScript><Notes></Notes><Comments></Comments><Value>[0E232FF0-B466-11cf-A24F-00AA00A3EFFF, 1.00]
