><![CDATA[BEGIN
    SET NOCOUNT ON;

    UPDATE E
    SET E.DATAELABORAZIONE = GETDATE()
    FROM dbo.DEP_EventiArca_Flussi AS E
    INNER JOIN inserted AS I
        ON E.ID = I.AnagraficaArcaID
    WHERE E.DATAELABORAZIONE IS NULL;
END;]]></SQL><Caption>TR_DEP_FlussiElaborati_DataElaborazione</Caption><GenerateSQLOnly>0</GenerateSQLOnly><AClassName></AClassName><AMethodName></AMethodName><Assembly/><CLRTrigger>0</CLRTrigger><EventDelete>0</EventDelete><EventInsert>1</EventInsert><EventUpdate>0</EventUpdate><ExecuteAs>CALLER</ExecuteAs><ExecuteAsUser></ExecuteAsUser><Fire>AFTER</Fire><NotForReplication>0</NotForReplication><Schema><Id>{9D7FDC2A-2DCE-4A1A-AF2F-C0521A3EA0B5}</Id></Schema><WithAppend>0</WithAppend><WithEncryption>0</WithEncryption><NativelyCompiled>0</NativelyCompiled></PERTriggerEntityMS17></Triggers><DbOwner/><Schema><Id>{9D7FDC2A-2DCE-4A1A-AF2F-C0521A3EA0B5}</Id></Schema><ViewRelations><Id>{3C259E95-FB63-423A-A30C-219AA0A128A5}</Id></ViewRelations><ChangeTracking>AUTO</ChangeTracking><ColumnList></ColumnList><Filegroup><Id>{FFCAEF17-2C90-43E8-8069-A73E55C74493}</Id></Filegroup><FulltextCatalog/><IndexName></IndexName><PartitionColumnName></PartitionColumnName><PartitionScheme/><RBDataSpace>1</RBDataSpace><TextFilegroup></TextFilegroup><TextFilegroupDisp/><CompressionType>NONE</CompressionType><FilestreamFilegroup/><FilestreamPartitionScheme/><FIStoplistOFF>0</FIStoplistOFF><FulltextIndexFilegroup/><IsPartitionCompression>0</IsPartitionCompression><PartitionCompression></PartitionCompression><SearchPropertyList/><Stoplist/><Durability>SCHEMA_AND_DATA</Durability><IsMemoryOptimized>0</IsMemoryOptimized><DataConsistencyCheck>1</DataConsistencyCheck><FilterPredicate></FilterPredicate><HistoryTable></HistoryTable><HistoryTableLink/><MigrationState>OUTBOUND</MigrationState><RemoteDataArchive>0</RemoteDataArchive><SystemVersioning>0</SystemVersioning><TemporalTableLink/><HistoryRetentionPeriod></HistoryRetentionPeriod><TableTypeMS></TableTypeMS></PEREntityMS17><PEREntityMS17 ObjectType="2002" CSAOName="PEREntityMS17" CSAOCaption="Entity"><Id>{ED7563A6-A58B-4674-B7AA-DCBB25884EFC}</Id><Name>DEP_DatiPensioni</Name><Ordinal>0</Ordinal><GlobalOrder>0</GlobalOrder><GalleryItemID>{00000000-