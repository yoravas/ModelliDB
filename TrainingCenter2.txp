INSERT INTO [TC_T_D_STATO_CORSO]
    ([id_stato_corso], [stato_corso], [des_stato_corso], [flag_utilizzabile], [note])
VALUES
    (1, N'Pianificato', N'Corso pianificato ma non ancora avviato.', 1, NULL),
    (2, N'Attivo',      N'Corso avviato e attualmente in svolgimento.', 1, NULL),
    (3, N'Chiuso',      N'Corso concluso.', 1, NULL),
    (4, N'Sospeso',     N'Corso sospeso temporaneamente.', 1, NULL),
    (5, N'Annullato',   N'Corso annullato.', 1, NULL);
</AfterScript><Notes>Pianificato; Attivo; Chiuso, Sospeso; Annullato</Notes><Comments></Comments><Caption>TC_T_D_STATO_CORSO</Caption><Size>0</Size><DataWarehouseType>0</DataWarehouseType><DevNotes></DevNotes><ExternalDependent>0</ExternalDependent><ExternalDependentList></ExternalDependentList><Relations><Id>{BBE0CC1B-383D-4564-A2D6-9160D57DB82A}</Id></Relations><Attributes><PERAttributeMS19 ObjectType="2003" CSAOName="PERAttributeMS19" CSAOCaption="Attribute"><Id>{0FF2B278-0C4D-4DEA-AABB-7DA5ADDFBCF9}</Id><Name>id_stato_corso</Name><Ordinal>1</Ordinal><GlobalOrder>0</GlobalOrder><GalleryItemID>{00000000-0000-0000-0000-000000000000}</GalleryItemID><GalleryID>{00000000-0000-0000-0000-000000000000}</GalleryID><GalleryObjectID>{00000000-0000-0000-0000-000000000000}</GalleryObjectID><RNOffset>0</RNOffset><RNLength>0</RNLength><IgnoreNC>0</IgnoreNC><VerifyState>1</VerifyState><Notes>Pianificato; Attivo; Chiuso; Sospeso; Annullato</Notes><Comments></Comments><DataTypeParam1></DataTypeParam1><DataTypeParam2></DataTypeParam2><KeepForeignKey>0</KeepForeignKey><DefaultValue></DefaultValue><NotNull>1</NotNull><Migrated>0</Migrated><Caption>id_stato_corso</Caption><Unique>0</Unique><OriginalName></OriginalName><CheckConstraint></CheckConstraint><CheckConstraintName></CheckConstraintName><ExternalFK>0</ExternalFK><DevNotes></DevNotes><DataEnabledUser>1</DataEnabledUser><ExternalFKList></ExternalFKList><KeyConstraintItems><Id>{DA8A33B5-FFF9-4B75-848D-ADC41688888D}</Id></KeyConstraintItems><PKForeignKeys><Id>{BE05DD5E-966D-4898-92F8-812373967002}</Id></PKForeignKeys><DictType/><Domain/><DataType><Id>{DF87E9B4-455C-4478-95BF-C0A03F4DE104}</Id></DataType><UserDataType/><Default/><KeyConstraint/><DataSettings/><Collate></Collate><Collate_override>0</Collate_override><ComputedColumn></ComputedColumn><ComputedColumn_override>0</ComputedColumn_override><DefaultConstraintName></DefaultConstraintName><DefaultConstraintName_override>0</DefaultConstraintName_override><Identity>0</Identity>